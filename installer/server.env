# Liberty server.env shipped at wlp\etc\server.env.
#
# Relative JAVA_HOME is resolved against the Liberty install
# (WLP_INSTALL_DIR = <install>\wlp), so "..\jre" points at the
# sibling <install>\jre directory that this installer lays down.
# This keeps the bundled JRE completely private to the install -
# nothing is added to PATH or to the system JAVA_HOME.
JAVA_HOME=..\jre
