<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v3 installer for an Open Liberty / WebSphere Liberty server package
  bundled with its own JRE.

  Layout produced on the target machine:

      %ProgramFiles%\<Manufacturer>\<ProductName>\
          wlp\
              etc\server.env            (JAVA_HOME=..\jre)
              etc\configure.bat         (writes bootstrap.properties)
              usr\servers\<name>\
                  server.xml            (uses ${variable} placeholders)
                  bootstrap.properties  (written at install time by CA)
          jre\                          (private JRE, NOT on PATH)

  Silent install example:
      msiexec /i LibertyServer.msi /quiet ^
          INSTALLFOLDER="D:\Liberty" ^
          DB_HOST=db.example.com DB_PORT=50000 ^
          DB_USER=appuser DB_PASSWORD=s3cret ^
          SERVICE_DISPLAY_NAME="My App Server"
-->
<?define ProductName      = "Liberty Server" ?>
<?define Manufacturer     = "Example Corp" ?>
<?define ProductVersion   = "1.0.0" ?>
<?define UpgradeCode      = "B7D8E4A2-6C3F-4F1A-9B8D-5E7F8A9C0D1E" ?>
<?ifndef LibertyServerName ?>
  <?define LibertyServerName = "defaultServer" ?>
<?endif?>
<?ifndef ServiceDisplayName ?>
  <?define ServiceDisplayName = "Liberty Application Server" ?>
<?endif?>

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <Product Id="*"
           Name="$(var.ProductName)"
           Language="1033"
           Version="$(var.ProductVersion)"
           Manufacturer="$(var.Manufacturer)"
           UpgradeCode="$(var.UpgradeCode)">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="$(var.ProductName) $(var.ProductVersion)"
             Manufacturer="$(var.Manufacturer)" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Fail fast on non-admin installs; registering a service needs elevation. -->
    <Condition Message="Administrator privileges are required to install [ProductName].">
      Privileged
    </Condition>

    <!-- ============================================================ -->
    <!-- Product icon                                                  -->
    <!--                                                               -->
    <!-- Shown in Control Panel > Programs and Features, and in any    -->
    <!-- shortcuts.  Place your .ico in the installer\ directory       -->
    <!-- alongside Product.wxs (light finds it via -b bindpath).       -->
    <!-- The .ico should contain 16x16, 32x32, 48x48, and 256x256     -->
    <!-- layers for crisp display at every DPI.                        -->
    <!-- ============================================================ -->
    <Icon Id="app.ico" SourceFile="app.ico" />
    <Property Id="ARPPRODUCTICON" Value="app.ico" />

    <!-- ============================================================ -->
    <!-- Public properties                                             -->
    <!--                                                               -->
    <!-- All uppercase + Secure="yes" so they can be overridden on the -->
    <!-- msiexec command line for silent/unattended installs.          -->
    <!-- Hidden="yes" on DB_PASSWORD keeps it out of the MSI log.     -->
    <!--                                                               -->
    <!--   msiexec /i LibertyServer.msi /quiet DB_HOST=mydb ...       -->
    <!-- ============================================================ -->
    <Property Id="DB_HOST"     Value="localhost" Secure="yes" />
    <Property Id="DB_PORT"     Value="50000"     Secure="yes" />
    <Property Id="DB_USER"     Value="dbuser"    Secure="yes" />
    <Property Id="DB_PASSWORD" Value=""           Secure="yes" Hidden="yes" />
    <Property Id="SERVICE_DISPLAY_NAME" Value="$(var.ServiceDisplayName)" Secure="yes" />

    <!-- ============================================================ -->
    <!-- Directory layout                                              -->
    <!-- ============================================================ -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="ManufacturerFolder" Name="$(var.Manufacturer)">
          <Directory Id="INSTALLFOLDER" Name="$(var.ProductName)">
            <!-- Populated by heat-generated LibertyComponents -->
            <Directory Id="LIBERTYDIR" Name="wlp" />
            <!-- Populated by heat-generated JreComponents -->
            <Directory Id="JREDIR" Name="jre" />
          </Directory>
        </Directory>
      </Directory>
    </Directory>

    <!-- ============================================================ -->
    <!-- Features                                                      -->
    <!-- ============================================================ -->
    <Feature Id="Complete"
             Title="$(var.ProductName)"
             Level="1"
             AllowAdvertise="no"
             ConfigurableDirectory="INSTALLFOLDER">
      <ComponentGroupRef Id="LibertyComponents" />
      <ComponentGroupRef Id="JreComponents" />
      <ComponentRef Id="CleanupOnUninstall" />
    </Feature>

    <!-- ============================================================ -->
    <!-- Cleanup component                                             -->
    <!--                                                               -->
    <!-- bootstrap.properties is written by a CA (not the File table), -->
    <!-- so RemoveFiles won't touch it.  RemoveFolderEx ensures the    -->
    <!-- entire install tree is cleaned up on uninstall.               -->
    <!-- ============================================================ -->
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="CleanupOnUninstall" Guid="E4F5A6B7-C8D9-4E0F-A1B2-C3D4E5F6A7B8">
        <CreateFolder />
        <util:RemoveFolderEx On="uninstall" Property="INSTALLFOLDER" />
      </Component>
    </DirectoryRef>

    <!-- ============================================================ -->
    <!-- User interface                                                -->
    <!--                                                               -->
    <!-- WixUI_InstallDir adds the standard "Choose install folder"    -->
    <!-- dialog (with a Change... button).  In silent mode (/quiet)    -->
    <!-- the UI is skipped entirely; INSTALLFOLDER defaults to the     -->
    <!-- ProgramFiles path unless overridden on the command line.      -->
    <!-- Requires linking with  -ext WixUIExtension                    -->
    <!-- ============================================================ -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <UIRef Id="WixUI_InstallDir" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <!-- ============================================================ -->
    <!-- Custom actions                                                -->
    <!--                                                               -->
    <!-- Pattern: an immediate SetProperty resolves [PROPERTY] values  -->
    <!-- into a command string, then a deferred WixQuietExec runs it   -->
    <!-- under SYSTEM.  This is the only way to pass runtime values    -->
    <!-- into a deferred (elevated) CA.                                -->
    <!-- ============================================================ -->

    <!-- 1. Write bootstrap.properties with the DB properties.         -->
    <!--    configure.bat lives at wlp\etc\configure.bat (staged by    -->
    <!--    build.bat, harvested by heat).  It writes key=value lines  -->
    <!--    into usr\servers\<name>\bootstrap.properties so Liberty's   -->
    <!--    ${variable} substitution in server.xml picks them up.      -->
    <CustomAction Id="SetWriteBootstrapProps"
                  Property="WriteBootstrapProps"
                  Value='"[LIBERTYDIR]etc\configure.bat" "[LIBERTYDIR]usr\servers\$(var.LibertyServerName)" "[DB_HOST]" "[DB_PORT]" "[DB_USER]" "[DB_PASSWORD]"'
                  Execute="immediate" />

    <CustomAction Id="WriteBootstrapProps"
                  BinaryKey="WixCA"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!-- 2. Register the Windows service via Liberty's own command.     -->
    <CustomAction Id="SetRegisterWinService"
                  Property="RegisterWinService"
                  Value='"[LIBERTYDIR]bin\server.bat" registerWinService $(var.LibertyServerName)'
                  Execute="immediate" />

    <CustomAction Id="RegisterWinService"
                  BinaryKey="WixCA"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!-- 3. Set service display name and startup type to Automatic.    -->
    <!--    Runs after registerWinService has created the service.      -->
    <!--    Note: sc.exe requires a space AFTER each "key= " token.    -->
    <CustomAction Id="SetConfigureWinService"
                  Property="ConfigureWinService"
                  Value='sc config $(var.LibertyServerName) DisplayName= "[SERVICE_DISPLAY_NAME]" start= auto'
                  Execute="immediate" />

    <CustomAction Id="ConfigureWinService"
                  BinaryKey="WixCA"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!-- 4. Unregister the Windows service on uninstall.               -->
    <CustomAction Id="SetUnregisterWinService"
                  Property="UnregisterWinService"
                  Value='"[LIBERTYDIR]bin\server.bat" unregisterWinService $(var.LibertyServerName)'
                  Execute="immediate" />

    <CustomAction Id="UnregisterWinService"
                  BinaryKey="WixCA"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- ============================================================ -->
    <!-- Sequencing                                                    -->
    <!-- ============================================================ -->
    <InstallExecuteSequence>
      <!-- Install: write config, register service, configure it.      -->
      <Custom Action="SetWriteBootstrapProps" After="InstallFiles">
        NOT Installed OR UPGRADINGPRODUCTCODE
      </Custom>
      <Custom Action="WriteBootstrapProps" After="SetWriteBootstrapProps">
        NOT Installed OR UPGRADINGPRODUCTCODE
      </Custom>

      <Custom Action="SetRegisterWinService" After="WriteBootstrapProps">
        NOT Installed OR UPGRADINGPRODUCTCODE
      </Custom>
      <Custom Action="RegisterWinService" After="SetRegisterWinService">
        NOT Installed OR UPGRADINGPRODUCTCODE
      </Custom>

      <Custom Action="SetConfigureWinService" After="RegisterWinService">
        NOT Installed OR UPGRADINGPRODUCTCODE
      </Custom>
      <Custom Action="ConfigureWinService" After="SetConfigureWinService">
        NOT Installed OR UPGRADINGPRODUCTCODE
      </Custom>

      <!-- Uninstall: unregister before files are removed.             -->
      <Custom Action="SetUnregisterWinService" Before="RemoveFiles">
        (REMOVE="ALL") OR (WIX_UPGRADE_DETECTED AND NOT UPGRADINGPRODUCTCODE)
      </Custom>
      <Custom Action="UnregisterWinService" After="SetUnregisterWinService">
        (REMOVE="ALL") OR (WIX_UPGRADE_DETECTED AND NOT UPGRADINGPRODUCTCODE)
      </Custom>
    </InstallExecuteSequence>

  </Product>
</Wix>
